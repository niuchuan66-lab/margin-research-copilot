APP_NAME=Margin
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=120
DOCLING_MAX_PAGES=60
OCR_MAX_PAGES=80

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://margin:margin@localhost:5432/margin

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=margin_chunks

# Valkey (Redis-compatible)
VALKEY_URL=redis://localhost:6379/0

# GROBID
GROBID_URL=http://localhost:8070

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Embeddings and reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional OpenAI-compatible embedding endpoint for the hybrid-search vector
# leg. Leave EMBEDDING_BASE_URL empty to keep retrieval fully local (BM25 +
# overlap); set it to enable the dense cosine leg, e.g.:
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v3
#   EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Frontend
VITE_API_BASE=/api/v1
