APP_NAME=Margin
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=120
MAX_PDF_PAGES=2000
PARSE_CONCURRENCY=2
DOCLING_MAX_PAGES=60
OCR_MAX_PAGES=80

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://margin:margin@localhost:5432/margin

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=margin_chunks

# Valkey (Redis-compatible)
VALKEY_URL=redis://localhost:6379/0

# GROBID
GROBID_URL=http://localhost:8070

# OpenAI-compatible LLM. A known LLM_PROVIDER owns its base URL and model;
# override per provider with <NAME>_BASE_URL / <NAME>_MODEL (e.g.
# MODELSCOPE_BASE_URL). LLM_BASE_URL / LLM_MODEL apply only when no provider
# preset is set. Free primary with paid fallback:
#   LLM_PROVIDER=modelscope
#   MODELSCOPE_API_KEY=...
#   LLM_FALLBACKS=deepseek
#   DEEPSEEK_API_KEY=...
#   modelscope  https://api-inference.modelscope.cn/v1  Qwen/Qwen3.5-35B-A3B
#               free ~2000 calls/day; needs Alibaba Cloud binding + real-name
#               auth; key is a ModelScope access token (MODELSCOPE_API_KEY)
#   zhipu       https://open.bigmodel.cn/api/paas/v4    glm-4.7-flash (free)
#   deepseek    https://api.deepseek.com/v1             deepseek-chat
#   dashscope   https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   openai      https://api.openai.com/v1               gpt-4.1-mini
# LLM_FALLBACKS adds automatic failover on 429/timeout; each fallback reads its
# own <NAME>_API_KEY, so the generic LLM_API_KEY is never sent to it.
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
DEEPSEEK_API_KEY=
MODELSCOPE_API_KEY=
ZHIPU_API_KEY=
LLM_FALLBACKS=
LLM_TIMEOUT_SECONDS=120

# Embeddings and reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional OpenAI-compatible embedding endpoint for the hybrid-search vector
# leg. Leave EMBEDDING_BASE_URL empty to keep retrieval fully local (BM25 +
# overlap); set it to enable the dense cosine leg, e.g.:
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v3
#   EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Frontend
VITE_API_BASE=/api/v1
